<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout_favicon" inherit_id="web.layout">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/church_theme/static/description/favicon.png'</attribute>
        </xpath>
    </template>

    <template id="login_layout" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="o_church_login" separator=" "/>
        </xpath>
    </template>
</odoo>
